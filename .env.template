# ============================================================================
# AutoTest-RL Environment Configuration Template
# Copy this file to .env and fill in your actual API keys
# ============================================================================

# Environment
ENVIRONMENT=development  # development, staging, production

# ============================================================================
# LOCAL LLM (Ollama) - NO API KEY NEEDED! 🎉
# ============================================================================
# Ollama runs locally in Docker - completely free and private!
# Default models automatically downloaded:
#   - Phi-3.5 Mini (3.8B params) - Best for reasoning & coding
#   - Llama 3.2 3B - Fast backup model
# No API keys required for local models!

OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434

# ============================================================================
# LLM API Keys (OPTIONAL - for cloud models if needed)
# ============================================================================
# You can use local Ollama models OR cloud APIs
# For local-only setup, leave these blank!

# OpenAI (GPT-4o, GPT-4o-mini) - OPTIONAL
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude (Claude 3.5 Sonnet) - OPTIONAL
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq (Llama models - FAST cloud inference) - OPTIONAL
# Get from: https://console.groq.com/
GROQ_API_KEY=

# Mistral (Embeddings ONLY) - REQUIRED for vector search
# Get from: https://console.mistral.ai/ (free tier available)
MISTRAL_API_KEY=your_mistral_api_key_here

# LlamaParse (Advanced PDF parsing) - OPTIONAL
# Get from: https://cloud.llamaindex.ai/
# Alternative: Use PyMuPDF4LLM (no key needed)
LLAMAPARSE_API_KEY=

# ============================================================================
# Database Configuration
# ============================================================================

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma_storage

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============================================================================
# Application Settings
# ============================================================================

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true  # Set to false in production

# File Upload Limits
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,json,yaml,yml

# ============================================================================
# RAG Configuration
# ============================================================================

# Chunking Strategy
CHUNK_SIZE=2000
CHUNK_OVERLAP=400

# Retrieval Settings
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# Embedding Model
EMBEDDING_MODEL=mistral-embed  # or openai-text-embedding-3-large

# ============================================================================
# LLM Model Selection
# ============================================================================

# Primary LLM for reasoning - LOCAL MODELS (FREE!) 🚀
LLM_PROVIDER=ollama  # ollama (local), openai, anthropic, groq
LLM_MODEL=phi3.5:3.8b  # Local: phi3.5:3.8b, llama3.2:3b, gemma2:2b
                        # Cloud: gpt-4o, claude-3-5-sonnet-20241022

# Fast LLM for quick tasks
FAST_LLM_PROVIDER=ollama
FAST_LLM_MODEL=llama3.2:3b  # Fastest local model

# LLM Temperature & Tokens
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096

# Available Ollama Models (auto-downloaded):
# - phi3.5:3.8b       → Best reasoning (3.8B params, ~2.3GB)
# - llama3.2:3b       → Fast general purpose (3B params, ~2GB)
# - gemma2:2b         → Very fast, efficient (2B params, ~1.6GB)
# - qwen2.5:3b        → Multilingual (3B params, ~2GB)

# ============================================================================
# Test Execution Settings
# ============================================================================

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=1

# HTTP Client
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_CONNECTIONS=100

# Test Parallelization
MAX_PARALLEL_TESTS=5

# ============================================================================
# Reinforcement Learning Configuration
# ============================================================================

# RL Algorithm
RL_ALGORITHM=PPO  # PPO, DQN, A2C

# Training Parameters
RL_LEARNING_RATE=0.0003
RL_GAMMA=0.99
RL_BATCH_SIZE=64
RL_N_STEPS=2048
RL_TOTAL_TIMESTEPS=100000

# Reward Weights
REWARD_COVERAGE_WEIGHT=10.0
REWARD_BUG_DISCOVERY_WEIGHT=50.0
REWARD_SUCCESS_WEIGHT=20.0
REWARD_FAILURE_PENALTY=-5.0
REWARD_RETRY_PENALTY=-1.0

# Curiosity Configuration
USE_CURIOSITY=true
CURIOSITY_WEIGHT=5.0

# ============================================================================
# Logging Configuration
# ============================================================================

# Log Level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Log Format
LOG_FORMAT=json  # json or text

# Log Files
LOG_DIR=./logs
LOG_FILE=autotest-rl.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ============================================================================
# Monitoring & Observability
# ============================================================================

# Enable Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Sentry (Error Tracking - Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================================================================
# Security
# ============================================================================

# API Authentication (if needed)
API_KEY_ENABLED=false
API_KEY=your_secure_api_key_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=*  # Comma-separated list or *
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# Development Settings
# ============================================================================

# Debug Mode
DEBUG=true

# Auto-reload on code changes
AUTO_RELOAD=true

# Seed for reproducibility
RANDOM_SEED=42
